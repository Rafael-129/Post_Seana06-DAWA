<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Post</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <style>
      body {
        background: linear-gradient(120deg, #009688 0%, #fbc2eb 100%);
        min-height: 100vh;
        font-family: 'Montserrat', Arial, sans-serif;
      }
      .glass-form {
        background: rgba(255,255,255,0.92);
        border-radius: 18px;
        box-shadow: 0 8px 32px 0 rgba(31,38,135,0.15);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,0.18);
        padding: 2.5rem 2rem 2rem 2rem;
        margin-top: 3rem;
        animation: fadeIn 1s;
      }
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(40px);}
        to { opacity: 1; transform: none;}
      }
      .main-header {
        background: rgba(255,255,255,0.25);
        box-shadow: none;
        padding: 2rem 0 1.5rem 0;
        margin-bottom: 0;
        text-align: center;
      }
      .main-header-title {
        color: #009688;
        font-family: 'Montserrat', Arial, sans-serif;
        font-weight: 700;
        font-size: 2.5rem;
        letter-spacing: 2px;
        margin: 0;
      }
      .form-title {
        font-weight: 700;
        letter-spacing: 1px;
        color: #009688;
        margin-bottom: 2rem;
        text-align: center;
      }
      .center-align {
        text-align: center !important;
      }
      .input-field label {
        color: #009688 !important;
      }
      .input-field input:focus + label,
      .input-field textarea:focus + label {
        color: #009688 !important;
      }
      .input-field input:focus,
      .input-field textarea:focus {
        border-bottom: 1.5px solid #009688 !important;
        box-shadow: 0 1px 0 0 #009688 !important;
      }
      .btn-mega {
        background: linear-gradient(90deg,#009688,#43cea2);
        color: #fff;
        font-weight: 600;
        border-radius: 30px;
        letter-spacing: 1px;
        box-shadow: 0 2px 8px #0002;
        transition: background 0.2s, box-shadow 0.2s;
      }
      .btn-mega:hover {
        background: linear-gradient(90deg,#43cea2,#009688);
        box-shadow: 0 6px 24px #00968844;
      }
      .back-link {
        margin-top: 1.5rem;
        display: block;
        text-align: center;
        color: #009688;
        font-weight: 500;
        transition: color 0.2s;
      }
      .back-link:hover {
        color: #43cea2;
        text-decoration: underline;
      }
    </style>
</head>
<body>
    <header class="main-header">
      <span class="main-header-title">Social Media</span>
    </header>
    <div class="container">
      <div class="row">
        <form class="col s12 m8 offset-m2 glass-form z-depth-2" action="/posts/<%= post._id %>" method="POST">
          <h4 class="form-title center-align"><i class="material-icons left">edit</i>Editar Post</h4>
          <div class="input-field">
              <input id="title" name="title" type="text" value="<%= post.title %>" required minlength="5" maxlength="30">
              <label for="title" class="active">Título</label>
          </div>
          <div class="input-field">
              <textarea id="content" name="content" class="materialize-textarea" required minlength="10"><%= post.content %></textarea>
              <label for="content" class="active">Contenido</label>
          </div>
          <div class="input-field">
              <input id="hashtags" name="hashtags" type="text" value="<%= post.hashtags ? post.hashtags.join(',') : '' %>">
              <label for="hashtags" class="active">Hashtags (separados por coma)</label>
          </div>
          <div class="input-field">
              <input id="imageUrl" name="imageUrl" type="text" value="<%= post.imageUrl %>">
              <label for="imageUrl" class="active">URL de imagen</label>
          </div>
          <div class="center-align" style="margin-top:2rem;">
              <button class="btn btn-mega waves-effect waves-light" type="submit">
                  Actualizar
                  <i class="material-icons right">save</i>
              </button>
          </div>
          <a href="/posts" class="back-link center-align"><i class="material-icons left">arrow_back</i>Volver</a>
        </form>
      </div>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>